# The llm-proxy release to run: the tag of both images (backend and frontend are
# released together with one version). Empty: the compose file's default. To
# upgrade, bump it and run: docker compose pull && docker compose up -d
LLMPROXY_VERSION=0.1.0

# Copy to .env and replace the placeholders. docker-compose.yml reads every value
# from here; nothing secret is written in the compose file. Only POSTGRES_PASSWORD
# is required; every other value falls back to the default the compose file sets.

# Postgres. The password need not be URL-safe: the backend receives it apart from
# the connection URL (as PGPASSWORD). The user and database names go into the URL
# as they are, so keep them to letters, digits and _ - .
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llmproxy

# The first administrator, created with a one-time password (printed once in the
# backend's log) while no administrator exists. Empty disables the bootstrap.
LLMPROXY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Where clients reach the proxied API; shown in the cabinet's connection instructions.
LLMPROXY_PUBLIC_API_URL=http://localhost:8080

# Host ports of the proxied API and the web interface, or address:port, such as
# 127.0.0.1:8080 behind a reverse proxy on the same host. Empty: 8080 and 8081.
LLMPROXY_API_PORT=
LLMPROXY_UI_PORT=

# Secure session cookies; the compose file defaults to false because it serves the
# web interface over plain http. Behind TLS, set true.
LLMPROXY_COOKIE_SECURE=

# Addresses/CIDRs of your reverse proxy, comma-separated, trusted by the frontend
# for X-Forwarded-For; empty trusts none.
REAL_IP_FROM=

# How many password hashes (about 19 MiB each) may run at once. Empty: the CPU count.
LLMPROXY_PASSWORD_HASH_CONCURRENCY=

# Upstream's model catalogue, fetched from raw.githubusercontent.com at start and
# every three hours; empty means on. off keeps the catalogue compiled into the
# build (air-gapped installations).
LLMPROXY_MODEL_CATALOG_UPDATES=

# The price catalog the metrics cost estimate uses under the administrator's
# overrides: oh-my-pi's model catalog (MIT). Empty means the default,
# https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/catalog/src/models.json;
# off turns it off (manual prices only).
LLMPROXY_PRICES_CATALOG_URL=
# How often the catalog is checked, a Go duration of at least 5m; empty means 6h.
LLMPROXY_PRICES_CATALOG_INTERVAL=

# Seals the OIDC sign-in cookie; required, at least 32 bytes, when OIDC is on.
# Generate one with: openssl rand -base64 48
LLMPROXY_SESSION_KEY=

# OIDC sign-in: on when LLMPROXY_OIDC_ISSUER is set, then client id, secret and
# redirect URL are required.
LLMPROXY_OIDC_ISSUER=
# Example: https://idp.example.com/realms/example
LLMPROXY_OIDC_CLIENT_ID=
LLMPROXY_OIDC_CLIENT_SECRET=
# Example: http://localhost:8081/api/auth/oidc/callback
LLMPROXY_OIDC_REDIRECT_URL=
# A group every federated user must be in; empty admits any.
LLMPROXY_OIDC_REQUIRED_GROUP=
# true lets a federated user without an invitation create an account.
LLMPROXY_OIDC_ALLOW_SIGNUP=
# Rules a signed-up user starts with, comma-separated (provider:model patterns).
LLMPROXY_OIDC_DEFAULT_POLICY=
# group=rule,rule;group=rule - when set, IdP groups own federated users' policies.
LLMPROXY_OIDC_GROUP_POLICY=
# The ID token claim holding the groups; empty means "groups".
LLMPROXY_OIDC_GROUPS_CLAIM=
# The sign-in button's label, such as the identity provider's name; empty leaves it
# to the frontend.
LLMPROXY_OIDC_DISPLAY_NAME=

# Email-and-password sign-in; empty means true. false leaves OIDC as the only way in
# (the bootstrap administrator is still created, but cannot sign in until this is
# true again). Setting it back to true is the way in if the identity provider fails.
LLMPROXY_LOCAL_LOGIN=
